# Microsoft 365 interactive sign-in (Auth.js / Entra ID)
# See docs/microsoft-entra.md for IT setup and redirect URIs.
# Redirect URI (local): http://localhost:3000/api/auth/callback/microsoft-entra-id
AUTH_SECRET=                      # e.g. openssl rand -base64 32
AUTH_MICROSOFT_ENTRA_ID_ID=       # Entra Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=   # Entra client secret value
AUTH_MICROSOFT_ENTRA_ID_ISSUER=   # https://login.microsoftonline.com/<TENANT_ID>/v2.0

# SharePoint unattended reader (Microsoft Graph client credentials — server only)
# See docs/sharepoint.md. Separate app from interactive AUTH_MICROSOFT_ENTRA_ID_* login.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=kannonmfg.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/FortWorth
SHAREPOINT_FILE_PATH=Production/Production Schedule/Production Scheduler - 2026.xlsx

# Supabase (server-only — used by Next.js API routes)
# Project URL from Supabase → Settings → API
SUPABASE_URL=
# Service role / secret key — never expose in browser code or NEXT_PUBLIC_* vars
SUPABASE_SECRET_KEY=
# Optional public anon key (not used while RLS has no public policies)
SUPABASE_ANON_KEY=

# Scheduling and invitations
CRON_SECRET=
RESEND_API_KEY=
INVITE_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
